# SAU-308 — Snowflake connection template. COPY to .env and fill in real values.
# .env is gitignored; NEVER commit real credentials. Prefer a secret store / the run
# environment over a file when one is available.
#
#   cp .env.example .env && $EDITOR .env
#   set -a; source .env; set +a            # export into the shell
#   python3 scripts/verify_snowflake.py    # confirm connectivity

# Required ------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=            # e.g. ab12345.eu-central-1 (Account Identifier, not the URL)
SNOWFLAKE_USER=

# Auth: set EITHER a password OR a key-pair path (key-pair preferred for automation)
SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/snowflake_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Optional session context --------------------------------------------------
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=MIGRATION_WH
SNOWFLAKE_DATABASE=MIGRATION_SPIKE
SNOWFLAKE_SCHEMA=PUBLIC
