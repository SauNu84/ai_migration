# Profiling + core-loop output are generated artifacts (scripts/setup.sh, run_loop.py).
artifacts/*.json
artifacts/sql/
artifacts/sql.*/

# Python
__pycache__/
*.pyc
.venv/
.venv-*/
venv/

# Orchestration scratch (dagster home, run logs)
.orch-tmp/

# Env / secrets — never commit
.env
.env.local
*.pem
# SAU-532 Phase-1 corpus output (corpus/generate.py) and its gate artifacts. The reference
# manifest — seed, SHA-256 of the SQL, per-entity in-DB content digests — is committed
# under corpus/reference/ instead, because it IS the byte-identical acceptance record.
artifacts/corpus/
artifacts/phase1/
